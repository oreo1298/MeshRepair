Enable "Fix model" on Linux and macOS with MeshRepair

Generated by integration/bambustudio/install.py from Bambu Studio v02.08.04.61
(also applies to current master). The patch does not contain the library itself:
copy libmeshrepair/ to src/meshrepair/ as well, or simply run install.py.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f1c5bc1..f5a92e4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -867,6 +867,17 @@ function(bambustudio_copy_sos target config postfix output_sos)
 endfunction()
 
 # libslic3r, BambuStudio GUI and the BambuStudio executable.
+# Model repair ("Fix model"): the Windows 10 3D printing SDK (netfabb) on Windows,
+# MeshRepair (src/meshrepair) wherever that SDK is not available (Linux, macOS).
+option(SLIC3R_MESHREPAIR "Use MeshRepair for Fix model when the Windows 10 SDK is not available" ON)
+if (WIN32 AND WIN10SDK_INCLUDE_PATH)
+    add_definitions(-DHAS_MODEL_REPAIR)
+elseif (SLIC3R_MESHREPAIR AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/meshrepair/CMakeLists.txt")
+    message("Building with MeshRepair model fixing support")
+    add_definitions(-DHAS_MESHREPAIR -DHAS_MODEL_REPAIR)
+    set(SLIC3R_HAS_MESHREPAIR TRUE)
+endif ()
+
 add_subdirectory(src)
 set_property(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR} PROPERTY VS_STARTUP_PROJECT BambuStudio_app_gui)
 
